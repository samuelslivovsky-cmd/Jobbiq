# Database
DATABASE_URL=postgresql://jobbiq:jobbiq@localhost:5432/jobbiq

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Anthropic (CV parsing, matching, email generation)
ANTHROPIC_API_KEY=

# Job source connectors
ADZUNA_APP_ID=
