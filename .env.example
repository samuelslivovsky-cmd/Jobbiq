# S3-compatible storage for CV files (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=jobbiq
S3_SECRET_KEY=jobbiq-secret
S3_BUCKET=jobbiq-cv
