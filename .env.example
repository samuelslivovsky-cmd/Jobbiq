# Database — locally docker-compose Postgres; on Vercel use Neon / Vercel
# Postgres (pgvector supported). Use the pooled connection string on Vercel.
DATABASE_URL=postgresql://jobbiq:jobbiq@localhost:5432/jobbiq

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Vercel Cron protection — Vercel sends this automatically as
# "Authorization: Bearer <CRON_SECRET>" when the env var is set.
CRON_SECRET=change-me

# OpenAI (CV parsing, matching, email generation)
OPENAI_API_KEY=

# Job source connectors (only needed for these two sources — the rest work
# without keys: Profesia.sk, Remotive, RemoteOK, We Work Remotely, Arbeitnow, Jobicy)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# free key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Vercel Blob (CV file storage) — created automatically when you add a Blob
# store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# SMTP for sending application emails. For Gmail: smtp.gmail.com:465 with an
# app password (per-user Gmail OAuth sending comes in a later phase).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
